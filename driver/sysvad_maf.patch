 class CMiniportWaveRTStream;
 typedef CMiniportWaveRTStream *PCMiniportWaveRTStream;
 
+//=============================================================================
+// Loopback mixer
+//=============================================================================
+// Every render stream (system pins for each mode, offload pins) is mixed into
+// one 16-bit stereo ring at LOOPBACK_MIX_RATE, indexed by QPC time. The loopback
+// pin reads it back LOOPBACK_MIX_DELAY_MS behind real time. Streams at other
+// rates are converted with linear interpolation.
+#define LOOPBACK_MIX_RATE               48000
+#define LOOPBACK_MIX_RING_SECONDS       2
+#define LOOPBACK_MIX_RING_FRAMES        (LOOPBACK_MIX_RATE * LOOPBACK_MIX_RING_SECONDS)
+#define LOOPBACK_MIX_DELAY_MS           40
+#define LOOPBACK_MIX_RESYNC_MS          20
+
+typedef struct _LOOPBACK_CURSOR
+{
+    BOOLEAN     Valid;
+    LONGLONG    RingFrame;      // next ring frame this stream writes or reads
+    ULONGLONG   Phase;          // resampler position, Q32
+    SHORT       Previous[2];    // last frame seen by the resampler
+    SHORT       Next[2];        // reader only: frame after Previous
+} LOOPBACK_CURSOR, *PLOOPBACK_CURSOR;
+

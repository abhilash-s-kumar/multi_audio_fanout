+//=============================================================================
+#pragma code_seg()
+NTSTATUS
+CMiniportWaveRT::EnsureLoopbackRing()
+{
+    if (m_LoopbackRing != NULL)
+    {
+        return STATUS_SUCCESS;
+    }
+
+    SHORT* ring = (SHORT*)ExAllocatePool2(POOL_FLAG_NON_PAGED, LOOPBACK_MIX_RING_FRAMES * 2 * sizeof(SHORT), MINWAVERT_POOLTAG);
+    if (ring == NULL)
+    {
+        return STATUS_INSUFFICIENT_RESOURCES;
+    }
+
+    KIRQL oldIrql;
+    KeAcquireSpinLock(&m_LoopbackBufferLock, &oldIrql);
+    if (m_LoopbackRing == NULL)
+    {
+        m_LoopbackBaseQpc = KeQueryPerformanceCounter(&m_LoopbackQpcFrequency);
+        m_LoopbackFrontier = 0;
+        m_LoopbackRing = ring;
+        ring = NULL;
+    }
+    KeReleaseSpinLock(&m_LoopbackBufferLock, oldIrql);
+
+    if (ring != NULL)
+    {
+        ExFreePoolWithTag(ring, MINWAVERT_POOLTAG);
+    }
+    return STATUS_SUCCESS;
+}
+
+//=============================================================================
+#pragma code_seg()
+LONGLONG
+CMiniportWaveRT::LoopbackNowFrame(_In_ LARGE_INTEGER Qpc)
+{
+    // Ring frame playing at Qpc. Split so the multiply cannot overflow.
+    LONGLONG ticks = Qpc.QuadPart - m_LoopbackBaseQpc.QuadPart;
+    LONGLONG freq = m_LoopbackQpcFrequency.QuadPart;
+    if (ticks < 0 || freq <= 0)
+    {
+        return 0;
+    }
+    return (ticks / freq) * LOOPBACK_MIX_RATE + ((ticks % freq) * LOOPBACK_MIX_RATE) / freq;
+}
+
+//=============================================================================
+#pragma code_seg()
+VOID
+CMiniportWaveRT::LoopbackAdvanceFrontier(_In_ LONGLONG EndFrame)
+{
+    // Clear ring frames [frontier, EndFrame) so writers can add into them.
+    // Called with m_LoopbackBufferLock held.
+    if (EndFrame <= m_LoopbackFrontier)
+    {
+        return;
+    }
+
+    LONGLONG start = m_LoopbackFrontier;
+    if (EndFrame - start > LOOPBACK_MIX_RING_FRAMES)
+    {
+        start = EndFrame - LOOPBACK_MIX_RING_FRAMES;
+    }
+    while (start < EndFrame)
+    {
+        ULONG offset = (ULONG)(start % LOOPBACK_MIX_RING_FRAMES);
+        ULONG run = (ULONG)min((LONGLONG)(LOOPBACK_MIX_RING_FRAMES - offset), EndFrame - start);
+        RtlZeroMemory(m_LoopbackRing + offset * 2, run * 2 * sizeof(SHORT));
+        start += run;
+    }
+    m_LoopbackFrontier = EndFrame;
+}
+
+//=============================================================================
+#pragma code_seg()
+VOID
+CMiniportWaveRT::MixRenderIntoLoopback
+(
+    _Inout_ PLOOPBACK_CURSOR Cursor,
+    _In_reads_bytes_(DmaBufferSize) BYTE* DmaBuffer,
+    _In_ ULONG DmaBufferSize,
+    _In_ ULONGLONG LinearPosition,
+    _In_ ULONG ByteCount,
+    _In_ ULONG SampleRate,
+    _In_ LARGE_INTEGER Qpc
+)
+/*++
+
+Routine Description:
+
+  Adds the frames a render stream played since its last position update into
+  the loopback ring at the time they played. Only 16-bit stereo is handled,
+  which is every format the speaker pins expose.
+
+--*/
+{
+    if (Cursor == NULL || DmaBuffer == NULL || ByteCount == 0 || DmaBufferSize < 4 || SampleRate == 0 || m_LoopbackRing == NULL)
+    {
+        return;
+    }
+
+    // Whole frames completed in [LinearPosition, LinearPosition + ByteCount).
+    ULONGLONG firstFrame = LinearPosition / 4;
+    ULONGLONG endFrame = (LinearPosition + ByteCount) / 4;
+    ULONG dmaFrames = DmaBufferSize / 4;
+    if (endFrame <= firstFrame || dmaFrames == 0)
+    {
+        return;
+    }
+    if (endFrame - firstFrame > dmaFrames)
+    {
+        // More time passed than the buffer holds, so audio was lost: realign to the clock.
+        firstFrame = endFrame - dmaFrames;
+        Cursor->Valid = FALSE;
+    }
+    ULONG frames = (ULONG)(endFrame - firstFrame);
+    ULONGLONG step = ((ULONGLONG)SampleRate << 32) / LOOPBACK_MIX_RATE;
+    LONGLONG ringFrames = (LONGLONG)(((ULONGLONG)frames << 32) / step);
+
+    KIRQL oldIrql;
+    KeAcquireSpinLock(&m_LoopbackBufferLock, &oldIrql);
+
+    LONGLONG now = LoopbackNowFrame(Qpc);
+    LONGLONG tolerance = (LOOPBACK_MIX_RATE * LOOPBACK_MIX_RESYNC_MS) / 1000;
+    if (!Cursor->Valid ||
+        Cursor->RingFrame + ringFrames > now + tolerance ||
+        Cursor->RingFrame + ringFrames < now - tolerance)
+    {
+        // First update, or the stream paused or drifted: place these frames so they end now.
+        SHORT* first = (SHORT*)(DmaBuffer + (ULONG)(firstFrame % dmaFrames) * 4);
+        Cursor->Valid = TRUE;
+        Cursor->RingFrame = now - ringFrames;
+        Cursor->Phase = 0;
+        Cursor->Previous[0] = first[0];
+        Cursor->Previous[1] = first[1];
+    }
+
+    LoopbackAdvanceFrontier(Cursor->RingFrame + ringFrames + 1);
+
+    for (ULONG i = 0; i < frames; ++i)
+    {
+        SHORT* frame = (SHORT*)(DmaBuffer + (ULONG)((firstFrame + i) % dmaFrames) * 4);
+
+        // Emit the ring frames that fall between Previous (position 0) and frame (position 1).
+        while (Cursor->Phase < (1ULL << 32))
+        {
+            LONGLONG fraction = (LONGLONG)Cursor->Phase;
+            if (Cursor->RingFrame >= 0 && Cursor->RingFrame >= m_LoopbackFrontier - LOOPBACK_MIX_RING_FRAMES && Cursor->RingFrame < m_LoopbackFrontier)
+            {
+                SHORT* out = m_LoopbackRing + (ULONG)(Cursor->RingFrame % LOOPBACK_MIX_RING_FRAMES) * 2;
+                for (ULONG ch = 0; ch < 2; ++ch)
+                {
+                    LONG value = Cursor->Previous[ch] + (LONG)((((LONGLONG)frame[ch] - Cursor->Previous[ch]) * fraction) >> 32);
+                    LONG mixed = out[ch] + value;
+                    out[ch] = (SHORT)(mixed > SHRT_MAX ? SHRT_MAX : (mixed < SHRT_MIN ? SHRT_MIN : mixed));
+                }
+            }
+            Cursor->RingFrame++;
+            Cursor->Phase += step;
+        }
+        Cursor->Phase -= (1ULL << 32);
+        Cursor->Previous[0] = frame[0];
+        Cursor->Previous[1] = frame[1];
+    }
+
+    KeReleaseSpinLock(&m_LoopbackBufferLock, oldIrql);
+}
+
+//=============================================================================
+#pragma code_seg()
+VOID
+CMiniportWaveRT::ReadLoopbackMix
+(
+    _Inout_ PLOOPBACK_CURSOR Cursor,
+    _Out_writes_bytes_(DmaBufferSize) BYTE* DmaBuffer,
+    _In_ ULONG DmaBufferSize,
+    _In_ ULONGLONG LinearPosition,
+    _In_ ULONG ByteCount,
+    _In_ ULONG SampleRate,
+    _In_ LARGE_INTEGER Qpc
+)
+/*++
+
+Routine Description:
+
+  Fills the frames a loopback stream captured since its last position update
+  with the ring mix from LOOPBACK_MIX_DELAY_MS ago. Ring frames no stream
+  wrote read as silence.
+
+--*/
+{
+    if (Cursor == NULL || DmaBuffer == NULL || ByteCount == 0 || DmaBufferSize < 4 || SampleRate == 0)
+    {
+        return;
+    }
+
+    ULONGLONG firstFrame = LinearPosition / 4;
+    ULONGLONG endFrame = (LinearPosition + ByteCount) / 4;
+    ULONG dmaFrames = DmaBufferSize / 4;
+    if (endFrame <= firstFrame || dmaFrames == 0)
+    {
+        return;
+    }
+    if (endFrame - firstFrame > dmaFrames)
+    {
+        // More time passed than the buffer holds, so audio was lost: realign to the clock.
+        firstFrame = endFrame - dmaFrames;
+        Cursor->Valid = FALSE;
+    }
+    ULONG frames = (ULONG)(endFrame - firstFrame);
+
+    if (m_LoopbackRing == NULL)
+    {
+        for (ULONG i = 0; i < frames; ++i)
+        {
+            *(ULONG*)(DmaBuffer + (ULONG)((firstFrame + i) % dmaFrames) * 4) = 0;
+        }
+        return;
+    }
+
+    ULONGLONG step = ((ULONGLONG)LOOPBACK_MIX_RATE << 32) / SampleRate;
+    LONGLONG ringFrames = (LONGLONG)(((ULONGLONG)frames * step) >> 32);
+
+    KIRQL oldIrql;
+    KeAcquireSpinLock(&m_LoopbackBufferLock, &oldIrql);
+
+    LONGLONG target = LoopbackNowFrame(Qpc) - (LOOPBACK_MIX_RATE * LOOPBACK_MIX_DELAY_MS) / 1000;
+    LONGLONG tolerance = (LOOPBACK_MIX_RATE * LOOPBACK_MIX_RESYNC_MS) / 1000;
+    if (!Cursor->Valid ||
+        Cursor->RingFrame + ringFrames > target + tolerance ||
+        Cursor->RingFrame + ringFrames < target - tolerance)
+    {
+        Cursor->Valid = TRUE;
+        Cursor->RingFrame = target - ringFrames;
+        Cursor->Phase = 0;
+        Cursor->Previous[0] = Cursor->Previous[1] = 0;
+        Cursor->Next[0] = Cursor->Next[1] = 0;
+    }
+
+    for (ULONG i = 0; i < frames; ++i)
+    {
+        // Step through ring frames until the output position lies between Previous and Next.
+        while (Cursor->Phase >= (1ULL << 32))
+        {
+            LONGLONG index = Cursor->RingFrame++;
+            Cursor->Phase -= (1ULL << 32);
+            Cursor->Previous[0] = Cursor->Next[0];
+            Cursor->Previous[1] = Cursor->Next[1];
+            if (index >= 0 && index < m_LoopbackFrontier && index >= m_LoopbackFrontier - LOOPBACK_MIX_RING_FRAMES)
+            {
+                SHORT* in = m_LoopbackRing + (ULONG)(index % LOOPBACK_MIX_RING_FRAMES) * 2;
+                Cursor->Next[0] = in[0];
+                Cursor->Next[1] = in[1];
+            }
+            else
+            {
+                Cursor->Next[0] = Cursor->Next[1] = 0;
+            }
+        }
+
+        LONGLONG fraction = (LONGLONG)Cursor->Phase;
+        SHORT* out = (SHORT*)(DmaBuffer + (ULONG)((firstFrame + i) % dmaFrames) * 4);
+        for (ULONG ch = 0; ch < 2; ++ch)
+        {
+            out[ch] = (SHORT)(Cursor->Previous[ch] + (LONG)((((LONGLONG)Cursor->Next[ch] - Cursor->Previous[ch]) * fraction) >> 32));
+        }
+        Cursor->Phase += step;
+    }
+
+    KeReleaseSpinLock(&m_LoopbackBufferLock, oldIrql);
+}
+
